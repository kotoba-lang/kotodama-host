(ns kotodama.host-util
  "appview 差替え面のユーティリティ guest 核（JUN-149: amu 適格化）。
  typed guest 覇約（型注釈必須・host interop 禁止・:kotoba 専用）。
  NSID 検証は bounded-regex を使わず **文字コードの歩き**で実装する
  （bounded-regex は `{}` 量詞を拒否し、class+`*` で trap した —— 実測）。
  kbb 側の oracle は host_surface.cljk（同一ベクタで両方を検証する双子）。
  効果は host_effects.cljk 側。意味の正本は本モジュール（TS SDK は prune 済み）。"
  (:require #?(:kotoba [kotoba.lang.bounded-text :as bounded-text]))
  (:export [nsid-valid? test-nsid-valid test-nsid-length-limits]))

(defn- lower-alpha? [c :i64] :bool
  (and (>= c 97) (<= c 122)))

(defn- upper-alpha? [c :i64] :bool
  (and (>= c 65) (<= c 90)))

(defn- digit? [c :i64] :bool
  (and (>= c 48) (<= c 57)))

(defn- label-rest-char? [c :i64] :bool
  ;; [a-z0-9-]（or は 2 引数ずつ畳む —— 実測で多引数論理式は fuel を喰う）
  (or (lower-alpha? c) (or (digit? c) (= c 45))))

(defn- name-rest-char? [c :i64] :bool
  ;; [a-zA-Z0-9]
  (or (lower-alpha? c) (or (upper-alpha? c) (digit? c))))

(defn- label-chars-ok? [s :string i :i64] :bool
  (if (>= i (string-byte-length s))
    true
    (if (label-rest-char? (string-code-point-at s i))
      (label-chars-ok? s (+ i 1))
      false)))

(defn- name-chars-ok? [s :string i :i64] :bool
  (if (>= i (string-byte-length s))
    true
    (if (name-rest-char? (string-code-point-at s i))
      (name-chars-ok? s (+ i 1))
      false)))

(defn- label-ok? [s :string] :bool
  ;; [a-z][a-z0-9-]{0,62}: 先頭小文字英字、残りは小文字英数字と -、長さ 63 まで。
  (and (>= (string-byte-length s) 1)
       (and (<= (string-byte-length s) 63)
            (and (lower-alpha? (string-code-point-at s 0))
                 (label-chars-ok? s 1)))))

(defn- name-ok? [s :string] :bool
  ;; [a-zA-Z][a-zA-Z0-9]*: 先頭英字、残りは英数字。
  (and (>= (string-byte-length s) 1)
       (and (or (lower-alpha? (string-code-point-at s 0))
                (upper-alpha? (string-code-point-at s 0)))
            (name-chars-ok? s 1))))

(defn- labels-ok? [v :string sep :string i :i64] :bool
  ;; index i（0-based）以下のラベルを全部検証する。
  (if (< i 0)
    true
    (if (label-ok? (bounded-text/segment-text v sep i))
      (labels-ok? v sep (- i 1))
      false)))

(defn nsid-valid?
  "NSID 形の検証（ATProto 形）。authority ラベル（小文字・先頭は英字・各 63
  文字まで）+ name（英字始まり英数字）。ラベル 2 つ以上・全長 253 以内。
  妥当なら true、不正なら false（fail closed）。"
  [v :string] :bool
  (let [sep "."
        n (bounded-text/segment-count-text v sep)]
    (and (>= n 2)
         (and (<= (string-byte-length v) 253)
              (and (labels-ok? v sep (- n 2))
                   (name-ok? (bounded-text/segment-text v sep (- n 1))))))))

;; ---- amu test（guest 覇約: ゼロ引数 test-*、戻り注釈 :i64、1/0）----

(defn test-nsid-valid [] :i64
  ;; and は 2 引数ずつ畳む（多引数 and は guest 実行で fuel/trap した —— 実測）。
  (if (and (nsid-valid? "com.example.doThing")
           (and (nsid-valid? "app.bsky.feed.getPosts")
                (and (not (nsid-valid? "no-dots"))
                     (and (not (nsid-valid? "com.example.0bad"))
                          (and (not (nsid-valid? "Com.example.doThing"))
                               (not (nsid-valid? "com..doThing")))))))
    1 0))

(defn test-nsid-length-limits [] :i64
  (let [long-label (bounded-text/repeat-text "a" 64)
        many (bounded-text/repeat-text "aaaaaaaaaa." 30)
        over (str "com." many "x")]
    (if (and (not (nsid-valid? (str "com." long-label ".x")))
             (not (nsid-valid? over)))
      1 0)))
