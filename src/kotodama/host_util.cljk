(ns kotodama.host-util
  "appview 差替え面のユーティリティ群（JUN-133: TS SDK prune 後の kotoba 側）。
  棚卸し（docs/appview-replacement-surface.md）の和集合のうち
  nowISO / nsid / genID / str / decodeJson を kotoba の語彙に落とす。
  TS SDK は prune 済みのため、意味はここで定義する（正本は本モジュール）。"
  #?(:cljs (:require [clojure.string :as str])))

(defn str'
  "文字列への中立な変換。文字列以外は空文字（appview 側の str ヘルパと同じ
  意味: 'typeof v === string ? v : empty'）。"
  [v]
  (if (string? v) v ""))

(defn now-iso
  "現在時刻の ISO 8601（UTC、ミリ秒 3 桁、Z 付き）。例:
  \"2026-10-20T09:15:00.000Z\"。"
  []
  #?(:cljs (.toISOString (js/Date.))
     :clj (str (.format (.withZone java.time.Instant/now
                                  java.time.ZoneOffset/UTC)
                        (java.time.format.DateTimeFormatter/ofPattern
                         "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'")))))

(def ^:private nsid-label-re
  #"[a-z][a-z0-9-]{0,62}")
(def ^:private nsid-name-re
  #"[a-zA-Z][a-zA-Z0-9]*")

(defn nsid
  "NSID 形の検証。authority ラベル（小文字、先頭は英字）+ name（英字始まり
  英数字）。合計 3〜253 文字。文字列をそのまま返し、不正なら nil。
  （ATProto NSID の形。appview は validate 用途で使う。）"
  [v]
  (when (string? v)
    (let [parts #?(:cljs (str/split v ".") :clj (clojure.string/split v #"\."))]
      (when (and (>= (count parts) 2)
                 (<= (count v) 253)
                 (every? #(re-matches nsid-label-re %) (butlast parts))
                 (re-matches nsid-name-re (last parts)))
        v))))

(defn gen-id
  "ユニーク ID（UUID 文字列）。実行環境の乱数に依存するため決定的ではない。"
  []
  #?(:cljs (str (random-uuid))
     :clj (str (java.util.UUID/randomUUID))))

(defn decode-json
  "JSON 文字列をデータへ。キーは文字列のまま。不正なら nil。
  実行面（amu selfhost / JS）では js/JSON、JVM では clojure.data.json 非依存
  のため未サポート（:jvm-unsupported を投げる）。"
  [s]
  (when (string? s)
    #?(:cljs (try
               (js->clj (js/JSON.parse s))
               (catch :default _ nil))
       :clj (throw (ex-info "decode-json is JS-runtime only (amu selfhost)"
                            {:jvm-unsupported true})))))
